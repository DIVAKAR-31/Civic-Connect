# Persistent PostgreSQL Connection String (Required for Vercel / Production)
# Example (Neon / Supabase / Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# JWT Signing Secret (set a strong random string in production)
AUTH_SECRET=change-this-to-a-long-random-secret

# Optional: Google Gemini API Key (server-side only; falls back to Demo AI Mode if unset)
GEMINI_API_KEY=

# Optional: Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGIN=https://civic-connect-six-tau.vercel.app

# Optional (Frontend): Set ONLY if deploying Express backend on a separate host (e.g. Render/Railway)
# Leave empty when using Vercel same-origin /api serverless routing
VITE_API_BASE_URL=
